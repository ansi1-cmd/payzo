generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id                String             @id @default(cuid())
  name              String
  icon              String             @default("receipt")
  color             String             @default("#6366f1")
  createdAt         DateTime           @default(now())
  expenses          Expense[]
  recurringExpenses RecurringExpense[]
}

model Expense {
  id             String    @id @default(cuid())
  description    String
  amount         Float
  currency       String    @default("ARS")
  categoryId     String
  category       Category  @relation(fields: [categoryId], references: [id])
  dueDate        DateTime
  paid           Boolean   @default(false)
  paidDate       DateTime?
  notes          String?
  source         String    @default("manual")
  emailMessageId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model ProcessedEmail {
  id        String   @id @default(cuid())
  messageId String   @unique
  subject   String
  sender    String
  result    String
  expenseId String?
  createdAt DateTime @default(now())
}

model PendingEmail {
  id          String   @id @default(cuid())
  messageId   String   @unique
  subject     String
  sender      String
  textContent String   @default("")
  htmlContent String   @default("")
  attachments String   @default("[]") // JSON: [{filename, contentBase64}]
  source      String   // "whitelist" | "keyword"
  senderName  String?  // hint from KnownSender
  categoryHint String? // hint from KnownSender
  pdfPassword String?  // resolved password for PDF attachments
  createdAt   DateTime @default(now())
}

model RecurringExpense {
  id          String   @id @default(cuid())
  description String
  amount      Float
  currency    String   @default("ARS")
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  dayOfMonth  Int
  active      Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
